# krivostr — copy to .env and adjust. Nothing here is read automatically by the
# Haskell binary: it reads the real environment, so `export` the variables or
# pass them through your process manager. This file documents the full set.

# ─── Bridge and CLI (krivostr serve, feed, search, dm, export, watch, api) ───
# SQLite database. The parent directory is created if missing.
KRIVOSTR_DB=.krivostr/events.db

# debug | info | warn | error
KRIVOSTR_LOG_LEVEL=info

# Bridge port for `krivostr serve`. It also serves the UI from KRIVOSTR_STATIC_DIR.
KRIVOSTR_PORT=8081

# Static UI directory. `krivostr serve` serves it when it exists.
KRIVOSTR_STATIC_DIR=./ui/dist

# Interface for `krivostr api`, which listens on its own port (--port, default 8090).
KRIVOSTR_API_HOST=127.0.0.1

# Secret key for `krivostr dm`, as nsec1... Generate one with `krivostr keygen`.
# Leave this unset in any shared environment: it is a spending key.
# KRIVOSTR_NSEC=nsec1...

# ─── UI (read by Vite at build time, so set before `pnpm build`) ────────────
# Where the browser opens its Nostr WebSocket. Leave unset when the UI and the
# bridge share an origin, which is what `krivostr serve` gives you. Required for
# `pnpm dev` (Vite does not proxy /ws) and for a UI hosted on Cloudflare Pages.
# VITE_BRIDGE_URL=ws://localhost:8081/ws

# relay | bridge — which transport the relay-status element offers. Can also be
# set per page with ?transport=bridge.
# VITE_KRIVOSTR_TRANSPORT=relay
