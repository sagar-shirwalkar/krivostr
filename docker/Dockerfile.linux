# ─── Portable Linux binary ──────────────────────────────────────────────
# Produces the Linux executable the release workflow publishes, and fails the
# build if it turns out to need anything unusual at runtime.
#
# Why this is not a fully static binary
# ------------------------------------
# `-optl-static` cannot work for GHC 9.10 on glibc. GHC 9.10 links its own
# internals -- ghc-bignum, ghc-prim, ghc-internal -- and Stackage's bindist
# ships those as shared objects only, with no .a to link against:
#
#   /usr/bin/ld.bfd: cannot find -lHSghc-bignum-1.3-627a-ghc9.10.3
#
# Alpine/musl would sidestep this (musl has no NSS problem and no split of
# GHC's libraries into .so-only pieces), but Docker Hub publishes no Alpine
# image for GHC 9.10 and lts-24.61 pins 9.10.3. So: build on glibc and link the
# compiler support libraries statically, which leaves glibc, libgmp and zlib as
# the runtime requirements.
#
# The floor is glibc 2.34, not the 2.36 of the build image. 2.34 is the point
# at which glibc merged libpthread into libc and retagged the pthread symbols
# from GLIBC_2.2.5 to GLIBC_2.34; GHC's threaded RTS, which arrives as a
# prebuilt .a in the bindist, was compiled against that newer glibc, so every
# executable linked against it inherits the newer version tags. The floor is a
# property of the toolchain, not of this project, and it is verified rather
# than assumed -- the resulting binary runs on bookworm (2.36) and on RHEL 9
# (2.34) but fails on bullseye (2.31) with "version `GLIBC_2.34' not found".
#
# In practice 2.34 costs nothing: the only distributions pinned near 2.33
# (Fedora 34, Ubuntu 21.04) are end-of-life, and every distribution that was
# compatible at 2.33 remains compatible at 2.34. RHEL 9, the oldest currently
# supported enterprise distribution, ships 2.34 exactly.
#
# The verification steps below are what hold this file to its promise: one
# lists the shared libraries the result needs, the other the highest versioned
# glibc symbol it references, and both fail if either has moved.

FROM haskell:9.10.3-slim-bookworm AS build

# libsecp256k1 is deliberately absent: BIP-340 is implemented in pure
# Haskell (core/src/Krivostr/Schnorr.hs), so the only C in the build is the
# sqlite3 amalgamation that sqlite-simple compiles itself.
RUN apt-get update && apt-get install --no-install-recommends -y \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY stack.yaml stack.yaml.lock ./
COPY core/ core/
COPY client/ client/

# Dependencies first, in their own layer: they are the slow part, and they do
# not change when only the link flags below are being adjusted.
RUN stack build --only-dependencies

# --copy-bins puts the executable at /out/krivostr.
#
#   -optl-static-libgcc      no libgcc_s.so.1 at runtime
#   -optl-static-libstdc++   no libstdc++.so.6 at runtime
#
# What is deliberately *not* passed: -optl-static, which cannot link GHC 9.10's
# own shared-only libraries, and -optl-fuse-ld=bfd, which is only needed to
# work around ld.gold's refusal to link a static glibc at all.
RUN stack build --copy-bins --local-bin-path /out \
      --ghc-options "-optl-static-libgcc -optl-static-libstdc++"

# Report the runtime dependencies, and fail on anything unexpected.
#
# Expected, and present on any glibc distribution worth the name:
#   libc, libm         the C runtime and the resolver
#   libdl, libpthread  separate files on glibc older than 2.34; on 2.34 and
#                      newer the linker resolves through libc, so these may
#                      still appear as versioned references even when the
#                      runtime has no separate files
#   libgmp             GHC's Integer arithmetic
#   libz               pulled in by the compression libraries in the dependency
#                      set
# Anything outside that list means the binary has picked up a dependency the
# release notes would not mention.
RUN set -eu; \
    ldd /out/krivostr | tee /tmp/ldd.txt; \
    if grep "=>" /tmp/ldd.txt \
       | grep -vE "libc\.so|libm\.so|libdl\.so|libpthread\.so|libgmp\.so|libz\.so|ld-linux|ld64"; then \
      echo "::error::binary depends on libraries this file does not expect"; \
      exit 1; \
    fi; \
    if grep -q "not a dynamic executable" /tmp/ldd.txt; then \
      echo "::error::binary came out fully static: update the release notes, not the check"; \
      exit 1; \
    fi; \
    /out/krivostr --version; \
    /out/krivostr --help > /dev/null

# Enforce the documented glibc floor, so a dependency bump cannot quietly raise
# it. ldd above cannot see this: it names files, not symbol versions, and it is
# the versioned symbols that decide whether the binary runs on bullseye. The
# highest GLIBC_x.y the executable requires has to stay at or below 2.34.
#
# The floor is 2.34 because the threaded RTS in GHC 9.10.3's bindist pulls in
# the GLIBC_2.34 retags of the pthread symbols (see the header). A run that
# reports GLIBC_2.35 or higher means the toolchain has moved again, and both
# this constant and the release notes' supported-distro list need updating in
# the same commit.
RUN set -eu; \
    objdump -p /out/krivostr \
      | grep -oE "GLIBC_[0-9]+(\.[0-9]+)*" | sort -uV > /tmp/glibc-reqs.txt; \
    echo "highest glibc symbol version required:"; tail -1 /tmp/glibc-reqs.txt; \
    highest=$(tail -1 /tmp/glibc-reqs.txt); \
    if [ -n "$highest" ] \
       && [ "$(printf '%s\nGLIBC_2.34\n' "$highest" | sort -V | tail -1)" != "GLIBC_2.34" ]; then \
      echo "::error::binary requires $highest, above the documented floor of GLIBC_2.34. If the toolchain changed, update the release notes and the supported-distro list together; if it did not, find which dependency started pulling in newer symbols."; \
      exit 1; \
    fi

FROM scratch AS artifact
COPY --from=build /out/krivostr /krivostr
